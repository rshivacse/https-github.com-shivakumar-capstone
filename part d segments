import os, itertools, math
import pandas as pd
import numpy as np
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans

os.makedirs("outputs", exist_ok=True)

df = pd.read_csv("data/modelling_table.csv")

# hub profile
agg = df.groupby("hub_id").agg(
    shipments=("shipment_id","count"),
    mean_delivery_hours=("delivery_hours","mean"),
    delay_rate=("is_delayed","mean"),
    mean_distance_km=("distance_km","mean"),
    mean_n_stops=("n_stops","mean")
).reset_index()
agg = agg.sort_values("hub_id")
agg.to_csv("outputs/hub_profile.csv", index=False)

# scaling and KMeans K=3
profile_cols = ["mean_delivery_hours","delay_rate","mean_distance_km","mean_n_stops"]
X = agg[profile_cols].values
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

kmeans3 = KMeans(n_clusters=3, random_state=42, n_init=10)
labels3 = kmeans3.fit_predict(X_scaled)
agg["cluster"] = labels3

# separation evidence for K=2..5
rows = []
for K in [2,3,4,5]:
    km = KMeans(n_clusters=K, random_state=42, n_init=10)
    lbl = km.fit_predict(X_scaled)
    # compute across vs within
    # 276 pairs
    n = len(X_scaled)
    within_dists = []
    across_dists = []
    for i in range(n):
        for j in range(i+1, n):
            d = np.linalg.norm(X_scaled[i]-X_scaled[j])
            if lbl[i]==lbl[j]:
                within_dists.append(d)
            else:
                across_dists.append(d)
    mean_within = np.mean(within_dists) if within_dists else 1
    mean_across = np.mean(across_dists) if across_dists else 0
    ratio = mean_across/mean_within if mean_within!=0 else 0
    # cluster sizes descending
    sizes = pd.Series(lbl).value_counts().sort_values(ascending=False).tolist()
    sizes_str = "-".join(map(str, sizes))
    rows.append([K, ratio, sizes_str])

pd.DataFrame(rows, columns=["K","across_over_within","cluster_sizes"]).to_csv("outputs/part_d_separation.csv", index=False)

# segment names ordered by mean delay_rate
cluster_means = agg.groupby("cluster")["delay_rate"].mean()
ordered = cluster_means.sort_values().index.tolist()
# map: lowest -> Standard, middle -> Watch, highest -> Escalate
name_map = {ordered[0]:"Standard", ordered[1]:"Watch", ordered[2]:"Escalate"}
agg["segment"] = agg["cluster"].map(name_map)

hubs = pd.read_csv("data/hubs.csv")
# hub_segments.csv: hub_id, segment, hub_city, hub_tier
out_seg = agg[["hub_id","segment"]].merge(hubs[["hub_id","hub_city","hub_tier"]], on="hub_id", how="left")
out_seg = out_seg.sort_values("hub_id")
out_seg = out_seg[["hub_id","segment","hub_city","hub_tier"]]
out_seg.to_csv("outputs/hub_segments.csv", index=False)

# segment_profile
seg_prof = agg.groupby("segment").agg(
    hubs=("hub_id","count"),
    mean_delivery_hours=("mean_delivery_hours","mean"),
    delay_rate=("delay_rate","mean"),
    mean_distance_km=("mean_distance_km","mean"),
    mean_n_stops=("mean_n_stops","mean")
).reset_index()
# ensure order Standard, Watch, Escalate by delay_rate
seg_prof = seg_prof.sort_values("delay_rate")
seg_prof.to_csv("outputs/segment_profile.csv", index=False)

# tier vs segment mismatch
# Tier 1 -> Standard, Tier2 -> Watch, Tier3 -> Escalate
expected = {1:"Standard",2:"Watch",3:"Escalate"}
out_seg["expected_segment"] = out_seg["hub_tier"].map(expected)
mismatch = out_seg[out_seg["segment"]!=out_seg["expected_segment"]][["hub_id","segment","hub_city","hub_tier"]]
mismatch.to_csv("outputs/tier_vs_segment_mismatch.csv", index=False)
print("Part D done")

print("Part D done")
