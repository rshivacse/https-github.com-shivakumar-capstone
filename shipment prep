import pandas as pd
import numpy as np

PROMISED_HOURS = {"Express": 36, "Standard": 60, "Economy": 96}
FEATURES = [
    "promised_hours", "distance_km", "parcel_weight_kg", "log_declared_value", "n_stops",
    "rain_flag", "sale_event_flag", "is_cod", "is_weekend", "dispatch_hour",
    "hub_tier", "hub_daily_capacity",
    "label_print_batch", "scanner_build_no", "tape_roll_no", "sticker_serial_mod", "shelf_slot_no",
]
NOISE_COLUMNS = ["label_print_batch", "scanner_build_no", "tape_roll_no", "sticker_serial_mod", "shelf_slot_no"]

def clean_shipments(raw, medians=None):
    df = raw.copy()
    # 1 drop exact duplicate rows
    df = df.drop_duplicates()
    # keep copy for counting? but steps order defined
    # 2 service_type strip and title case
    if "service_type" in df.columns:
        df["service_type"] = df["service_type"].astype(str).str.strip().str.title()
    # 3 payment_mode replace missing with Unknown
    if "payment_mode" in df.columns:
        df["payment_mode"] = df["payment_mode"].fillna("Unknown")
    # 4 declared_value -> declared_value_inr
    if "declared_value" in df.columns:
        # remove rupee and commas, convert
        def parse_val(x):
            if pd.isna(x):
                return np.nan
            s = str(x).replace("₹", "").replace(",", "").strip()
            try:
                return float(s)
            except:
                return np.nan
        df["declared_value_inr"] = df["declared_value"].apply(parse_val)
        df = df.drop(columns=["declared_value"])
    # 5 dispatch_time to datetime
    if "dispatch_time" in df.columns:
        df["dispatch_time"] = pd.to_datetime(df["dispatch_time"], errors="coerce")
    # 6 parcel_weight_kg sentinel >100 -> missing
    if "parcel_weight_kg" in df.columns:
        df.loc[df["parcel_weight_kg"] > 100, "parcel_weight_kg"] = np.nan

    # 7 fill missing
    # compute medians if None
    if medians is None:
        medians_computed = {}
        for col in ["distance_km", "parcel_weight_kg", "declared_value_inr"]:
            if col in df.columns:
                medians_computed[col] = float(df[col].median())
            else:
                medians_computed[col] = 0.0
    else:
        medians_computed = medians

    for col in ["distance_km", "parcel_weight_kg", "declared_value_inr"]:
        if col in df.columns:
            df[col] = df[col].fillna(medians_computed[col])

    # ensure float for medians dict
    medians_out = {k: float(v) for k, v in medians_computed.items()}

    return df, medians_out

def build_features(clean, hubs):
    df = clean.copy()
    hubs_df = hubs.copy()
    # left merge
    df = df.merge(hubs_df, on="hub_id", how="left")
    # promised_hours
    df["promised_hours"] = df["service_type"].map(PROMISED_HOURS).astype(int)
    # is_cod
    df["is_cod"] = (df["payment_mode"] == "COD").astype(int)
    # is_weekend
    df["is_weekend"] = (df["dispatch_time"].dt.dayofweek >= 5).astype(int)
    # dispatch_hour
    df["dispatch_hour"] = df["dispatch_time"].dt.hour.astype(int)
    # log_declared_value
    df["log_declared_value"] = np.log(df["declared_value_inr"])
    return df


    
